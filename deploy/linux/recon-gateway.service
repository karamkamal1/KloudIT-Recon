[Unit]
Description=KloudIT Recon gateway
Documentation=https://github.com/karamkamal1/KloudIT-Recon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=recon
Group=recon
EnvironmentFile=-/etc/kloudit-recon/gateway.env
ExecStart=/opt/kloudit-recon/recon-gateway -data /var/lib/kloudit-recon
Restart=on-failure
RestartSec=2

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
UMask=0077
StateDirectory=kloudit-recon
StateDirectoryMode=0700
ReadWritePaths=/var/lib/kloudit-recon
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
